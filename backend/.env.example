# Template for backend/.env — copy to backend/.env and fill in.
# All values are read by app/config.py (env_prefix APP_).

# --- Application ---
APP_APP_NAME=SIH26188 Document Screening
APP_API_PREFIX=/api
APP_ALLOWED_IMAGE_TYPES=["image/jpeg","image/jpg","image/png","image/bmp","image/tiff","image/webp"]
APP_MAX_UPLOAD_BYTES=20971520
APP_TESSERACT_CMD=

# --- Phase 5: Intelligence Layer LLM (advisory; off by default) ---
APP_LLM_ENABLED=false
APP_LLM_PROVIDER=anthropic
APP_LLM_MODEL=claude-opus-5
# Put your Anthropic API key here (or leave empty and export ANTHROPIC_API_KEY).
APP_LLM_API_KEY=
APP_LLM_BASE_URL=
APP_LLM_TIMEOUT_SECONDS=30
APP_LLM_MAX_OUTPUT_TOKENS=3000

# --- Persistence (analysis records) ---
APP_DATABASE_URL=sqlite:///./screening.db
APP_EVIDENCE_DIR=./evidence_store
APP_PERSIST_ANALYSES=true
APP_DB_AUTO_CREATE=true
